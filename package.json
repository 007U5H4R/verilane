{
  "name": "verilane",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eval next.config.ts playwright.config.ts vitest.config.ts eslint.config.mjs --ignore-pattern src/domain/__lint__/**",
    "lint:domain-fixture": "eslint src/domain/__lint__/forbidden.fixture.ts",
    "test": "vitest run --project unit",
    "perf": "vitest run --project perf",
    "eval": "vitest run --project eval",
    "build:e2e": "NEXT_PUBLIC_E2E=1 next build",
    "e2e": "playwright test",
    "e2e:install": "tsx scripts/e2e-install.ts",
    "e2e:splash-perf": "SPLASH_PERF=1 playwright test tests/e2e/splash-perf.spec.ts --project=chromium-light --workers=1",
    "check:secrets": "tsx scripts/check-bundle-secrets.ts",
    "route-budget": "tsx scripts/route-budget.ts",
    "splash-budget": "tsx scripts/splash-budget.ts",
    "check:e2e-hooks": "tsx scripts/check-e2e-hooks.ts",
    "check:deploy-env": "tsx scripts/check-deploy-env.ts",
    "vercel-build": "pnpm check:deploy-env && pnpm build && pnpm check:secrets && pnpm check:e2e-hooks",
    "seed": "tsx scripts/seed.ts",
    "eval:live": "tsx --conditions=react-server scripts/eval-live.ts",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm perf && pnpm eval && pnpm build && pnpm check:secrets && pnpm check:e2e-hooks && pnpm route-budget && pnpm splash-budget && pnpm build:e2e && pnpm e2e --workers=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fake-indexeddb": "6.2.6",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-formatter-compact": "^9.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
